#version 460
// 把一个三角形画进 8 × 8 的帧缓冲，同 sw/kernels/raster.asm：0 至 8 是三条边函数的 A、B、C（8 位有符号），
// 9 是颜色，帧缓冲在 64 起。像素 (x, y) 上三条边都不为负就写颜色，帧缓冲不清，后画的盖住先画的
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Mem { uint mem[256]; };
layout(push_constant) uniform Launch { uint threads; };

int s8(uint v) { return int(v << 24) >> 24; }

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= threads) return;
  uint x = i % 8, y = i / 8;
  bool inside = true;
  for (uint e = 0; e < 3; e++) inside = inside && s8((mem[3 * e] * x + mem[3 * e + 1] * y + mem[3 * e + 2]) & 0xff) >= 0;
  if (inside) mem[64 + i] = mem[9];
}
