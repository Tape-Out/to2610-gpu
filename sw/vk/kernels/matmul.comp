#version 460
// C = A × B，4 × 4，按行存：A 在 0 起，B 在 16 起，C 写到 32 起。同 sw/kernels/matmul.asm
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Mem { uint mem[256]; };
layout(push_constant) uniform Launch { uint threads; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= threads) return;
  uint row = i / 4, col = i % 4, acc = 0;
  for (uint k = 0; k < 4; k++) acc += mem[row * 4 + k] * mem[16 + k * 4 + col];
  mem[32 + i] = acc & 0xff;
}
