#version 460
// 8 × 8 的灰度图，一个像素到中心 (4, 4) 距离的平方乘 7，写到 64 起。同 sw/kernels/shade.asm
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Mem { uint mem[256]; };
layout(push_constant) uniform Launch { uint threads; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= threads) return;
  ivec2 d = ivec2(i % 8, i / 8) - 4;
  mem[64 + i] = uint(7 * (d.x * d.x + d.y * d.y)) & 0xff;
}
