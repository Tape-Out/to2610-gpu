#version 460
// y[i] = a·x[i] + y[i]，同 sw/kernels/saxpy.asm：x 在 0 起，y 在 16 起，a 是 3。数据存储一格一个 8 位数
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Mem { uint mem[256]; };
layout(push_constant) uniform Launch { uint threads; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= threads) return;
  mem[16 + i] = (3 * mem[i] + mem[16 + i]) & 0xff;
}
