// 单元测试：只测这一颗设计，不经过 FrameTop。
// 片外是一台 SPI 主机。先看复位后各脚的方向；经 SPI 读管理口标识与芯片标识；
// 写进一段六条指令的内核（四个线程各往自己的地址存「线程号加 5」），起跑，在 done 脚上等结束，读回四个字节核对。
// SPI 管理口、两块存储、tiny-gpu 的四个线程与状态脚都走到。更大的内核在设计仓的整片测试里。

module @UNIT_TOP@;

  localparam int IO_WIDTH = 66;
  localparam time HALF_PERIOD = 10ns;

  // payload 位次，照流片说明的板级连接表；视频（RGB332、两个同步、DE、像素钟）占 0 起的 12 位
  localparam int VIDEO = 12;
  localparam int SCK = 56;
  localparam int CS_N = 57;
  localparam int MOSI = 58;
  localparam int MISO = 59;
  localparam int DONE = 60;
  localparam int BUSY = 61;

  localparam logic [31:0] BASE = 32'h1000_0000;
  localparam int TIMEOUT_CYCLES = 60_000;

  // i = blockIdx * blockDim + threadIdx；mem[i] = i + 5
  localparam int KERNEL_WORDS = 6;
  localparam logic [15:0] KERNEL [KERNEL_WORDS] = '{
    16'h50de,   // MUL R0, %blockIdx, %blockDim
    16'h300f,   // ADD R0, R0, %threadIdx
    16'h9105,   // CONST R1, #5
    16'h3110,   // ADD R1, R1, R0
    16'h8001,   // STR R0, R1
    16'hf000    // RET
  };

  logic clock = 1'b0;
  logic reset = 1'b1;
  logic [IO_WIDTH-1:0] io_in = '0;
  wire [IO_WIDTH-1:0] io_out;
  wire [IO_WIDTH-1:0] io_oe;

  always #(HALF_PERIOD) clock = ~clock;

  UserDesignDut #(.IO_WIDTH(IO_WIDTH)) dut (
    .clock(clock), .reset(reset), .io_in(io_in),
    .io_out(io_out), .io_oe(io_oe)
  );

  // SPI 模式 0，高位先出。SCK 周期 12 拍，慢于上限（主频的八分之一）。从口在 SCK 下降沿之后换位，主机在上升沿采
  task automatic spi_byte(input logic [7:0] tx, output logic [7:0] rx);
    for (int i = 7; i >= 0; i--) begin
      io_in[MOSI] = tx[i];
      repeat (6) @(negedge clock);
      io_in[SCK] = 1'b1;
      @(posedge clock);
      if (io_oe[MISO] !== 1'b1) $fatal(1, "MISO is not driven while CS_N is low");
      rx[i] = io_out[MISO];
      repeat (6) @(negedge clock);
      io_in[SCK] = 1'b0;
    end
  endtask

  task automatic spi_word(input logic [31:0] tx, output logic [31:0] rx);
    logic [7:0] b;
    for (int k = 3; k >= 0; k--) begin
      spi_byte(tx[8*k +: 8], b);
      rx[8*k +: 8] = b;
    end
  endtask

  task automatic spi_begin();
    io_in[CS_N] = 1'b0;
    repeat (8) @(negedge clock);
  endtask

  task automatic spi_end();
    repeat (8) @(negedge clock);
    io_in[CS_N] = 1'b1;
    repeat (24) @(negedge clock);
  endtask

  // 0x02 写一个字；0x03 读一个字（地址之后空一个字节）
  task automatic bus_write(input logic [31:0] addr, input logic [31:0] data);
    logic [7:0] b;
    logic [31:0] w;
    spi_begin();
    spi_byte(8'h02, b);
    spi_word(addr, w);
    spi_word(data, w);
    spi_end();
  endtask

  task automatic bus_read(input logic [31:0] addr, output logic [31:0] data);
    logic [7:0] b;
    logic [31:0] w;
    spi_begin();
    spi_byte(8'h03, b);
    spi_word(addr, w);
    spi_byte(8'h00, b);
    spi_word(32'd0, data);
    spi_end();
  endtask

  initial begin
    repeat (TIMEOUT_CYCLES) @(posedge clock);
    $fatal(1, "not finished after %0d cycles", TIMEOUT_CYCLES);
  end

  initial begin
    logic [7:0] b;
    logic [31:0] w;

    io_in[CS_N] = 1'b1;
    repeat (20) @(posedge clock);
    @(negedge clock);
    reset = 1'b0;
    repeat (4) @(posedge clock);
    #1ns;

    // 方向：视频、done 与 busy 一直驱动；MISO 要等 CS_N 拉低；别的位都不驱动。复位后没在跑
    if (io_oe[BUSY:DONE] !== 2'b11) $fatal(1, "done and busy are not driven after reset");
    if (io_oe[VIDEO-1:0] !== '1) $fatal(1, "video pads are not driven after reset: %h", io_oe);
    if (io_oe[MISO:VIDEO] !== '0 || io_oe[IO_WIDTH-1:BUSY+1] !== '0)
      $fatal(1, "pads other than video, done and busy are driven after reset: %h", io_oe);
    if (io_out[BUSY] !== 1'b0) $fatal(1, "busy is high after reset");

    spi_begin();
    spi_byte(8'h9f, b);
    spi_word(32'd0, w);
    spi_end();
    if (w !== 32'h5350_4953) $fatal(1, "identify read %h, expected 53504953", w);
    bus_read(BASE + 32'h010, w);
    if (w !== 32'h5447_5055) $fatal(1, "chip ID reads %h, expected 54475055", w);

    for (int i = 0; i < KERNEL_WORDS; i++) bus_write(BASE + 32'h400 + 32'(4 * i), {16'd0, KERNEL[i]});
    bus_write(BASE + 32'h004, 32'd4);
    bus_write(BASE, 32'd1);
    while (io_out[DONE] !== 1'b1) @(posedge clock);
    if (io_out[BUSY] !== 1'b0) $fatal(1, "busy is still high when done rises");

    for (int i = 0; i < 4; i++) begin
      bus_read(BASE + 32'h800 + 32'(4 * i), w);
      if (w !== 32'(i + 5)) $fatal(1, "thread %0d stored %0d, expected %0d", i, w, i + 5);
    end
    bus_read(BASE + 32'h00c, w);
    if (w == 32'd0) $fatal(1, "the cycle counter did not run");

    $display("@UNIT_TOP@ PASS: loaded a kernel over SPI, four threads ran it in %0d cycles", w);
    $finish;
  end

endmodule
